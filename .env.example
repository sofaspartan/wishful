# ─────────────────────────────────────────────────────────────────────────────
# Wishful environment variables
# Copy to `.env` for local development. On Netlify, set these under
# Site configuration → Environment variables. None of these are exposed to the
# browser (no VITE_ prefix) — they are only read by the serverless API.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed site, used to build links in emails.
# On Netlify this falls back to the built-in `URL` variable automatically.
APP_URL=http://localhost:5174

# Transactional email via Resend (https://resend.com — free tier: 3,000/month).
# Optional: passwords are reset with recovery codes, so the site works without it.
# When set, it adds emailed reset links, invitations, reminders and notifications.
# Without it, emails are skipped and (in local dev only) printed to the console.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="Wishful <hello@yourdomain.com>"

# Storage driver override: `netlify` | `fs` | `memory`.
# Leave blank: Netlify Blobs is used automatically when deployed on Netlify,
# and a local file store in ./.data is used during `npm run dev`.
STORAGE_DRIVER=

# Directory for the local file store (fs driver only).
DATA_DIR=.data

# Product name used in emails sent by the API. The web app's name, tagline and
# colours are configured in src/config/brand.ts.
BRAND_NAME=Wishful

# Accounts allowed to use site integrations (Brickfolio: mirror a LEGO
# collection and wishlist from published Google Sheet CSVs; Playshelf: mirror a
# video game library and wishlist). Comma-separated email addresses. Everyone
# else gets a 404 and never sees the feature.
# Example: INTEGRATION_ALLOWED_EMAILS=you@example.com
INTEGRATION_ALLOWED_EMAILS=

# Playshelf integration: the Supabase project Playshelf stores games in.
# Use the same values as Playshelf's NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. The anon key is the public one Playshelf's
# own pages use, so only libraries set to public can be read. Never put the
# service_role key here.
PLAYSHELF_SUPABASE_URL=
PLAYSHELF_SUPABASE_ANON_KEY=
# Optional: the Playshelf site's address, for "view profile" links.
# Example: PLAYSHELF_SITE_URL=https://your-playshelf.netlify.app
PLAYSHELF_SITE_URL=

# Gift ideas page (App → Gift ideas): product search across stores. Shopify's
# Global Catalog works with no keys; each other store is optional and switches
# on when its keys are set. All are free.
#
# Shopify Global Catalog — searches products from shops built on Shopify.
# Optional: a catalog key raises the keyless rate limit. https://dev.shopify.com
# /dashboard → Catalogs → Get an API key; use its client ID and client secret.
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
# Optional: set to off to stop searching Shopify.
SHOPIFY_CATALOG=
# Optional: your own UCP agent profile URL (defaults to the one Shopify hosts
# for its docs).
SHOPIFY_UCP_PROFILE_URL=
#
# eBay Browse API — https://developer.ebay.com → create a Production keyset.
# Use the App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: an eBay Partner Network campaign ID, so eBay links earn commission.
EBAY_CAMPAIGN_ID=
#
# Best Buy Products API — https://developer.bestbuy.com → Get API Key, then
# activate it from the email.
BESTBUY_API_KEY=
#
# Etsy Open API v3 — https://www.etsy.com/developers/your-apps → Create a new
# app (it's reviewed before it works). Use the Keystring and the Shared secret.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
#
# Optional: an Amazon Associates tag (e.g. yourname-20) added to the "Search
# Amazon" link. Amazon's search API isn't used: it needs 10 sales a month first.
AMAZON_ASSOCIATE_TAG=

# Set to 1 to disable rate limiting (useful for local load testing only —
# never set this in production).
RATE_LIMIT_DISABLED=
