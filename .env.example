# ─────────────────────────────────────────────────────────────────────────────
# Wishful environment variables
# Copy to `.env` for local development. On Netlify, set these under
# Site configuration → Environment variables. None of these are exposed to the
# browser (no VITE_ prefix) — they are only read by the serverless API.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed site, used to build links in emails.
# On Netlify this falls back to the built-in `URL` variable automatically.
APP_URL=http://localhost:5173

# Transactional email via Resend (https://resend.com — free tier: 3,000/month).
# Required in production for password-reset and invitation emails.
# Without it, emails are skipped and (in local dev only) printed to the console.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
EMAIL_FROM="Wishful <hello@yourdomain.com>"

# Storage driver override: `netlify` | `fs` | `memory`.
# Leave blank: Netlify Blobs is used automatically when deployed on Netlify,
# and a local file store in ./.data is used during `npm run dev`.
STORAGE_DRIVER=

# Directory for the local file store (fs driver only).
DATA_DIR=.data

# Product name used in emails sent by the API. The web app's name, tagline and
# colours are configured in src/config/brand.ts.
BRAND_NAME=Wishful

# Set to 1 to disable rate limiting (useful for local load testing only —
# never set this in production).
RATE_LIMIT_DISABLED=
